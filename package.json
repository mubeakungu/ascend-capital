{
  "name": "ascend-capital",
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev-electron": "concurrently \"vite\" \"node server/index.js\" \"electron .\"",
    "build": "vite build",
    "build-web": "vite build",
    "build-electron": "vite build && electron-builder",
    "preview": "vite preview",
    "start": "node server/index.js",
    "electron": "electron .",
    "electron-dev": "electron-builder --publish never",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.ascendcapital.app",
    "productName": "Ascend Capital",
    "files": [
      "dist/**/*",
      "server/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/ascend-logo.jpg"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/ascend-logo.jpg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/ascend-logo.jpg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
